NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never expose to the browser.
# Supabase → Settings → API → service_role key (bypasses RLS; admin routes only).
SUPABASE_SERVICE_ROLE_KEY=
# Password gating /admin. Pick your own value.
ADMIN_PASSWORD=

# Resend (resend.com) — sends new-enquiry/tasting/match-request notification emails
# to the team. Free tier's default onboarding@resend.dev sender is fine. If unset,
# notifications are skipped silently (submissions still work).
RESEND_API_KEY=
